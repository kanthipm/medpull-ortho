<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>BGTaskSchedulerPermittedIdentifiers</key>
	<array>
		<string>io.tryvital.VitalHealthKit.ProcessingTask</string>
	</array>
	<key>CFBundleDevelopmentRegion</key>
	<string>$(DEVELOPMENT_LANGUAGE)</string>
	<key>CFBundleDisplayName</key>
	<string>MedPull</string>
	<key>CFBundleExecutable</key>
	<string>$(EXECUTABLE_NAME)</string>
	<key>CFBundleIdentifier</key>
	<string>$(PRODUCT_BUNDLE_IDENTIFIER)</string>
	<key>CFBundleInfoDictionaryVersion</key>
	<string>6.0</string>
	<key>CFBundleName</key>
	<string>$(PRODUCT_NAME)</string>
	<key>CFBundlePackageType</key>
	<string>APPL</string>
	<key>CFBundleShortVersionString</key>
	<string>1.0</string>
	<key>CFBundleURLTypes</key>
	<array>
		<dict>
			<key>CFBundleURLName</key>
			<string>com.medpull.recovery</string>
			<key>CFBundleURLSchemes</key>
			<array>
				<string>medpull</string>
			</array>
		</dict>
	</array>
	<key>CFBundleVersion</key>
	<string>1</string>
	<key>MedPullAPIBaseURL</key>
	<string>$(MEDPULL_API_BASE_URL)</string>
	<key>NSAppTransportSecurity</key>
	<dict>
		<key>NSAllowsArbitraryLoads</key>
		<true/>
	</dict>
	<key>NSCameraUsageDescription</key>
	<string>MedPull uses the camera only when you choose to send your care team a photo or a short video from the chat.</string>
	<key>NSHealthShareUsageDescription</key>
	<string>MedPull shares your activity, sleep, heart and walking data with your care team so they can follow your recovery between visits.</string>
	<key>NSHealthUpdateUsageDescription</key>
	<string>MedPull does not write to Health, but the Health SDK it uses declares this capability.</string>
	<key>NSLocationWhenInUseUsageDescription</key>
	<string>On an outdoor walk, MedPull uses your location only to measure how far you walked. It is never tracked otherwise.</string>
	<key>NSMicrophoneUsageDescription</key>
	<string>Talk to MedPull instead of typing, or record a voice note for your care team — the microphone is only on while you are recording.</string>
	<key>NSMotionUsageDescription</key>
	<string>MedPull records your phone’s motion during a guided walk or a joint measurement so your care team can follow how you are walking and moving.</string>
	<key>NSSpeechRecognitionUsageDescription</key>
	<string>MedPull turns what you say into text so it can log your pain, mark tasks done, or pass a note to your care team.</string>
	<key>UIAppFonts</key>
	<array>
		<string>Outfit-ExtraLight.ttf</string>
		<string>Outfit-Light.ttf</string>
		<string>Outfit-Regular.ttf</string>
		<string>Outfit-Medium.ttf</string>
		<string>Outfit-SemiBold.ttf</string>
	</array>
	<key>UIApplicationSceneManifest</key>
	<dict>
		<key>UIApplicationSupportsMultipleScenes</key>
		<false/>
	</dict>
	<key>UIBackgroundModes</key>
	<array>
		<string>processing</string>
	</array>
	<key>UILaunchScreen</key>
	<dict>
		<key>UIColorName</key>
		<string>LaunchBackground</string>
		<key>UIImageName</key>
		<string>LaunchMark</string>
	</dict>
	<key>UISupportedInterfaceOrientations</key>
	<array>
		<string>UIInterfaceOrientationPortrait</string>
	</array>
</dict>
</plist>
