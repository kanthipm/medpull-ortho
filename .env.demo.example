# Copy to .env.demo — the public demo stack (make deploy-demo). It is a
# second CloudFormation stack from the same code, with its own bucket,
# secrets and domain, seeded with the fake roster and open to visitors.
# .env (the real app) is the other one; nothing here touches it.

STACK_NAME=medpull-demo
# The demo: welcome screen, roster caption, seed allowed, console open.
DEMO_MODE=true
SEED=demo
# The unsigned demo webhook, for feeding the fake roster by hand.
ALLOW_MOCK_WEBHOOK=true

# The demo narrates through Groq like the real app; the same key is fine.
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b

# No live integrations on the demo: nobody real is on it, so no texts go
# out and no device is linked. Leave these empty.
JUNCTION_API_KEY=
JUNCTION_WEBHOOK_SECRET=
SENDBLUE_API_KEY=
SENDBLUE_API_SECRET=
SENDBLUE_WEBHOOK_SECRET=
CARE_TEAM_PHONES=

# Open console: this is the one deployment that should have no token.
CONSOLE_ACCESS_TOKEN=

# demo.medpull.org: an ISSUED ACM certificate in us-east-1 for that name,
# and a CNAME from the zone owner to the distribution deploy.sh prints.
SITE_DOMAIN=demo.medpull.org
SITE_CERTIFICATE_ARN=

# The demo's trail, if any: the same log bucket as the real app's, data
# events only — the real stack (or the account trail) already records the
# management events, and a second copy of those is the part that costs.
TRAIL_BUCKET=
TRAIL_MANAGEMENT_EVENTS=false
