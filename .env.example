# Copy to .env — all values optional; the app runs fully without any keys.
#
# What this file can and cannot set: only the block below is read from .env.
# app/config.py loads recovery-copilot/.env and backend/.env; the AWS block at
# the bottom is a different settings class (app/aws/config.py) that declares no
# env_file at all, so those names are read from the process environment only.
# They are listed here as documentation of the deployment's knobs (set by
# infra/cloudformation.yaml), not as settings you can turn on by editing this
# file.
#
# LLM provider priority (cloud-first): Groq (if key set) -> deterministic
# rules-based fallback. Local Ollama is OPT-IN: it joins the chain as the
# middle tier only when OLLAMA_URL is set explicitly.

# Groq (free tier: https://console.groq.com) — the cloud model the app calls.
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile

# OPT-IN local Ollama (leave unset to stay cloud-only). The model must answer
# without chain-of-thought — qwen3-vl-agent does; plain qwen3-vl does not.
# OLLAMA_URL=http://127.0.0.1:11434
OLLAMA_MODEL=qwen3-vl-agent:latest

# Junction (fka Vital) — the live wearable aggregator. Get a team API key and
# a webhook signing secret from app.junction.com (sandbox keys start with
# sk_us_ / sk_eu_ and only work against the sandbox host). With the key unset
# the connector is idle: the Integrations page says "Needs setup" and every
# per-patient link/backfill route answers 503.
JUNCTION_API_KEY=
# sandbox | production. A sandbox key against the production host is a 401
# from Junction, never a silent cross-environment write.
JUNCTION_ENVIRONMENT=sandbox
# us | eu — which Junction region the team lives in.
JUNCTION_REGION=us
# Explicit host override (leave empty to derive from environment + region).
JUNCTION_BASE_URL=
# Where Junction Link sends the patient after they connect a device. Empty
# leaves them on Junction's own completion screen.
JUNCTION_LINK_REDIRECT_URL=
# Intraday heart-rate samples: off unless something consumes HR_SAMPLE — the
# engine scores resting HR, and a day of watch samples is thousands of rows.
JUNCTION_INGEST_HEART_RATE_SAMPLES=false

# Webhook signing secrets. Verification fails closed: a provider whose scheme
# needs a secret and has none rejects every delivery with a 401. Junction's is
# the Svix "whsec_..." secret shown when you register
#   https://<your host>/api/webhooks/wearables/junction
# as an endpoint in Junction's webhook dashboard. Terra is not wired into
# connectors/registry.py, so its path answers 501 before verification; the
# demo `mock` endpoint is unsigned by design and needs no secret.
JUNCTION_WEBHOOK_SECRET=
TERRA_SIGNING_SECRET=

# SQLite database location. Relative paths are resolved against the process's
# working directory, which is why this one works: every Makefile target runs
# from backend/. The built-in default is the same file as an absolute path
# (backend/data/recovery.db), so leaving this unset is the safer choice.
DATABASE_URL=sqlite:///data/recovery.db

# ---------------------------------------------------------------------------
# AWS — ENVIRONMENT VARIABLES ONLY, not read from this file (see the note at
# the top). infra/cloudformation.yaml sets them on the deployed functions;
# locally you would have to export them into the environment. With S3_BUCKET
# unset the whole AWS layer disables itself and the app runs off the local
# SQLite file exactly as before.
# ---------------------------------------------------------------------------

# Durable home of the SQLite database. Setting this turns on S3 persistence.
S3_BUCKET=
S3_DB_KEY=db/recovery.db
S3_LOCK_KEY=db/recovery.db.lock

# Shared secret CloudFront injects so the public Function URL can't be called
# directly. Blank = no origin check.
ORIGIN_VERIFY_SECRET=

# SSM Parameter Store names (SecureString) holding the Groq key, the Junction
# API key and the Junction webhook secret. Read once per cold start by
# app/lambda_handler.py and nowhere else, so they override the plain env vars
# on Lambda and have no effect on a local run.
GROQ_API_KEY_PARAMETER=
JUNCTION_API_KEY_PARAMETER=
JUNCTION_WEBHOOK_SECRET_PARAMETER=

# The background insight warmer is a laptop convenience — off on Lambda, where
# it would re-run every cold start and race other instances. Defaults to on;
# infra/cloudformation.yaml sets it to "false" on both deployed functions.
WARM_CACHES_ON_STARTUP=true
