# Copy to .env — all values optional; the app runs fully without any keys.
#
# What this file can and cannot set: only the block below is read from .env.
# app/config.py loads recovery-copilot/.env and backend/.env; the AWS block at
# the bottom is a different settings class (app/aws/config.py) that declares no
# env_file at all, so those names are read from the process environment only.
# They are listed here as documentation of the deployment's knobs (set by
# infra/cloudformation.yaml), not as settings you can turn on by editing this
# file.
#
# LLM provider priority (cloud-first): Groq (if key set) -> deterministic
# rules-based fallback. Local Ollama is OPT-IN: it joins the chain as the
# middle tier only when OLLAMA_URL is set explicitly.

# Groq (free tier: https://console.groq.com) — the cloud model the app calls.
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b

# OPT-IN local Ollama (leave unset to stay cloud-only). The model must answer
# without chain-of-thought — qwen3-vl-agent does; plain qwen3-vl does not.
# OLLAMA_URL=http://127.0.0.1:11434
OLLAMA_MODEL=qwen3-vl-agent:latest

# Junction (fka Vital) — the live wearable aggregator. Get a team API key and
# a webhook signing secret from app.junction.com (sandbox keys start with
# sk_us_ / sk_eu_ and only work against the sandbox host). With the key unset
# the connector is idle: the Integrations page says "Needs setup" and every
# per-patient link/backfill route answers 503.
JUNCTION_API_KEY=
# sandbox | production. A sandbox key against the production host is a 401
# from Junction, never a silent cross-environment write.
JUNCTION_ENVIRONMENT=sandbox
# us | eu — which Junction region the team lives in.
JUNCTION_REGION=us
# Explicit host override (leave empty to derive from environment + region).
JUNCTION_BASE_URL=
# Where Junction Link sends the patient after they connect a device. Empty
# leaves them on Junction's own completion screen.
JUNCTION_LINK_REDIRECT_URL=
# Intraday heart-rate samples: off unless something consumes HR_SAMPLE — the
# engine scores resting HR, and a day of watch samples is thousands of rows.
JUNCTION_INGEST_HEART_RATE_SAMPLES=false

# Webhook signing secrets. Verification fails closed: a provider whose scheme
# needs a secret and has none rejects every delivery with a 401. Junction's is
# the Svix "whsec_..." secret shown when you register
#   https://<your host>/api/webhooks/wearables/junction
# as an endpoint in Junction's webhook dashboard. Terra is not wired into
# connectors/registry.py, so its path answers 501 before verification; the
# demo `mock` endpoint is unsigned by design and needs no secret.
JUNCTION_WEBHOOK_SECRET=
TERRA_SIGNING_SECRET=

# Sendblue (https://sendblue.co) — SMS/iMessage delivery for two outbound
# flows in app/notifications/sendblue.py: care-team alerts (the SMS channel)
# and patient check-in invitations (send_checkin_message). Both keys are the
# switch: with either empty, nothing sends. Recipient numbers live on
# care_team_members.phone rows or are passed by the caller, never in code.
SENDBLUE_API_KEY=
SENDBLUE_API_SECRET=
# Optional: which of the account's Sendblue numbers sends (E.164, e.g. +1...).
SENDBLUE_FROM_NUMBER=
# Care-team phone numbers, applied to care_team_members rows at startup so
# real numbers never enter the public repo: "id=+1...,id=+1...".
# Steve's assigned provider is ct_alvarez.
CARE_TEAM_PHONES=
# Public base URL used in patient check-in links (e.g. the CloudFront domain).
# Empty derives it from the incoming request — fine locally. On AWS the stack
# sets it to https://SITE_DOMAIN automatically when a custom domain is on.
CHECKIN_BASE_URL=

# --- The patient app (ios/) ------------------------------------------------
# Inbound Sendblue texts (patients replying to task texts, or messaging the
# care team). Set this to the signing secret configured on the Sendblue
# account (sent as the sb-signing-secret header) and register
# https://<your host>/api/webhooks/sendblue as the webhook URL; an account
# with no header secret can use .../api/webhooks/sendblue/<this value>
# instead. Unset, the route answers 503 and no inbound text is processed.
SENDBLUE_WEBHOOK_SECRET=
# URL scheme the iOS app registers (task texts deep-link into it).
MOBILE_APP_SCHEME=medpull
# Onboarding can text a 6-digit code to verify the phone when Sendblue is
# configured. Off by default (frictionless enrollment); true requires the
# code before the app gets a session.
MOBILE_OTP_REQUIRED=false
# Apple team id + bundle id, for /.well-known/apple-app-site-association so
# https task links open straight in the app. Nothing is served while unset.
IOS_TEAM_ID=
IOS_BUNDLE_ID=com.medpull.recovery

# --- MedPull Personal (the subscription tier, app/personal) -----------------
# Every personal account starts on a trial this long; after it the readouts
# answer 402 until an Apple subscription is on file.
PERSONAL_TRIAL_DAYS=14
# The App Store product ids the app sells (comma separated). A signed
# transaction for any other product is refused.
PERSONAL_PRODUCT_IDS=com.medpull.recovery.personal.monthly,com.medpull.recovery.personal.annual
# How a StoreKit 2 signed transaction is checked before it grants access.
# "lenient" decodes the payload and checks bundle id, product and expiry
# (what Xcode's local StoreKit testing can pass; grants are recorded as
# unverified). "strict" verifies the certificate chain to Apple's root and
# the ES256 signature. Move to strict once App Store Connect is live.
APPLE_SUBSCRIPTION_VERIFY=lenient
# Sandbox | Production — the environment a strict check accepts.
APPLE_ENVIRONMENT=Sandbox
# SHA-256 of Apple Root CA - G3 (DER). Confirm against
# https://www.apple.com/certificateauthority/ before turning strict mode on.
APPLE_ROOT_CA_G3_SHA256=63343abfb89a6a03ebb57e9b3f5fa7be7c4f5c756f3017b3a8c488c3653e9179
# When the morning run fires on AWS (EventBridge cron, UTC). Read by
# infra/deploy.sh, not by the app.
PERSONAL_DAILY_CRON=cron(0 12 * * ? *)

# Custom domain for the AWS deployment, read by infra/deploy.sh (not by the
# app). Both or neither. The certificate is an ACM cert in us-east-1 that has
# reached ISSUED; deploy.sh refuses to run with a pending one. The DNS record
# (SITE_DOMAIN CNAME -> the distribution's *.cloudfront.net name) is added by
# whoever holds the medpull.org hosted zone. See infra/README.md.
SITE_DOMAIN=
SITE_CERTIFICATE_ARN=

# SQLite database location. Relative paths are resolved against the process's
# working directory, which is why this one works: every Makefile target runs
# from backend/. The built-in default is the same file as an absolute path
# (backend/data/recovery.db), so leaving this unset is the safer choice.
DATABASE_URL=sqlite:///data/recovery.db

# ---------------------------------------------------------------------------
# AWS — ENVIRONMENT VARIABLES ONLY, not read from this file (see the note at
# the top). infra/cloudformation.yaml sets them on the deployed functions;
# locally you would have to export them into the environment. With S3_BUCKET
# unset the whole AWS layer disables itself and the app runs off the local
# SQLite file exactly as before.
# ---------------------------------------------------------------------------

# Durable home of the SQLite database. Setting this turns on S3 persistence.
S3_BUCKET=
S3_DB_KEY=db/recovery.db
S3_LOCK_KEY=db/recovery.db.lock
# The personal tier's own bucket (subscribers' files and exports). Set by
# the stack; empty falls back to S3_BUCKET.
PERSONAL_S3_BUCKET=

# Shared secret CloudFront injects so the public Function URL can't be called
# directly. Blank = no origin check.
ORIGIN_VERIFY_SECRET=

# SSM Parameter Store names (SecureString) holding the Groq key, the Junction
# API key + webhook secret, and the Sendblue key + secret. Read once per cold
# start by app/lambda_handler.py and nowhere else, so they override the plain
# env vars on Lambda and have no effect on a local run.
GROQ_API_KEY_PARAMETER=
JUNCTION_API_KEY_PARAMETER=
JUNCTION_WEBHOOK_SECRET_PARAMETER=
SENDBLUE_API_KEY_PARAMETER=
SENDBLUE_API_SECRET_PARAMETER=

# The background insight warmer is a laptop convenience — off on Lambda, where
# it would re-run every cold start and race other instances. Defaults to on;
# infra/cloudformation.yaml sets it to "false" on both deployed functions.
WARM_CACHES_ON_STARTUP=true
